{
  "name": "@archmodel/core",
  "version": "0.1.1",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "npm run build:library && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build:library && npm run typecheck && vite build -c vite.config.site.ts && node tools/build-standalone.mjs",
    "preview": "vite preview -c vite.config.site.ts --host 127.0.0.1",
    "build:library": "vite build -c vite.config.library.ts && tsc -p tsconfig.library.json",
    "verify": "node tools/generate-field-reference.mjs --check && npm run build && npm test && node tools/verify-site.mjs",
    "cli": "node tools/cli.mjs",
    "reference": "node tools/generate-field-reference.mjs",
    "prepack": "npm run build:library"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "@archmap/icons": "file:vendor/archmap-icons-0.1.3.tgz",
    "js-yaml": "^4.3.2",
    "mermaid": "12.0.0"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  },
  "description": "Model-first architecture DSL with traceability, validation and design questions",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/archmodel.js"
    },
    "./schema": "./schema/archmodel.schema.json"
  },
  "types": "./dist/types/src/index.d.ts",
  "files": [
    "dist",
    "schema",
    "syntax/reference.md",
    "syntax/examples",
    "tools/cli.mjs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/archmodel.js",
  "bin": {
    "archmodel": "./tools/cli.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-org-labs/archmodel.git"
  },
  "homepage": "https://ai-org-labs.github.io/archmodel/",
  "bugs": {
    "url": "https://github.com/ai-org-labs/archmodel/issues"
  }
}
